# Mnemo API Environment Variables
# Copy this file to .env and fill in your keys

# Supabase (required)
# Get from: supabase.com → Settings → API
MNEMO_SUPABASE_URL=
MNEMO_SUPABASE_SERVICE_KEY=

# Mem0 (required for memory)
# Get from: app.mem0.ai → API Keys
MNEMO_MEM0_API_KEY=

# Langfuse (required for tracing)
# Get from: cloud.langfuse.com → Settings
MNEMO_LANGFUSE_PUBLIC_KEY=
MNEMO_LANGFUSE_SECRET_KEY=

# Anthropic (required for AI Cop)
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Optional: Your Railway port (default 8000)
PORT=8000

# Optional: Enable debug logging
MNEMO_DEBUG=false
