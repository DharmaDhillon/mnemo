# Mnemo Environment Variables
# Copy this to .env and fill in your values

# Supabase (required for dashboard + multi-tenancy)
MNEMO_SUPABASE_URL=
MNEMO_SUPABASE_SERVICE_KEY=

# Mem0 (required for agent memory)
MNEMO_MEM0_API_KEY=

# Langfuse (required for trace observability)
MNEMO_LANGFUSE_PUBLIC_KEY=
MNEMO_LANGFUSE_SECRET_KEY=

# OpenTelemetry (optional — for enterprise observability stacks)
MNEMO_OPENTELEMETRY_ENDPOINT=

# Stripe (optional — for Mnemo Cloud billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LLM Providers (optional — only needed if using Mnemo's built-in LLM calls)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Debug mode
MNEMO_DEBUG=false
